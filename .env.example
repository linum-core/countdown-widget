# Origem pública do site.
#
# Opcional. Usada em metadata, sitemap, Open Graph e nas URLs geradas pela
# homepage. Na Vercel, a origem é detectada automaticamente; defina esta
# variável apenas quando usar um domínio próprio.
NEXT_PUBLIC_SITE_URL=https://countdown.seudominio.com

# Google AdSense — anúncios da homepage.
#
# Todas opcionais. Sem NEXT_PUBLIC_ADSENSE_CLIENT o site roda exatamente como
# antes: nenhum script é baixado, nenhum banner de cookies aparece e /ads.txt
# responde 404. Os anúncios nunca alcançam o widget em /w.
#
# Cada slot é o ID da unidade criada no painel do AdSense; um slot ausente apaga
# só o anúncio correspondente. Detalhes em docs/ADS.md.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_RAIL_LEFT=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_RAIL_RIGHT=0000000000
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=0000000000
